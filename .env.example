# Токен доступа к OpenAI-совместимому API
OPENAI_API_KEY=

# Базовый URL API (для OpenAI: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# Название модели, например gpt-4o-mini или локальная модель
OPENAI_MODEL=

# Температура генерации: 0.0 — строго, 1.0 — креативно (необязательно)
OPENAI_TEMPERATURE=0.7

# Максимальная длина ответа в токенах (необязательно)
OPENAI_MAX_TOKENS=2000

# Таймаут запроса в секундах (необязательно)
OPENAI_TIMEOUT=60
